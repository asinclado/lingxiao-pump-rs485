// ============================================================================
// secrets.h.example
//
// Copy this file to  secrets.h  (same folder) and fill in your own values.
// secrets.h is listed in .gitignore so your real credentials are never
// committed to the repository.
//
//     cp secrets.h.example secrets.h      (Linux/macOS)
//     copy secrets.h.example secrets.h    (Windows)
// ============================================================================

#pragma once

// ---- WiFi ----
#define WIFI_SSID   "YOUR_WIFI_SSID"
#define WIFI_PASS   "YOUR_WIFI_PASSWORD"

// ---- MQTT broker ----
#define MQTT_HOST   "192.168.1.10"      // your broker IP or hostname
#define MQTT_PORT   1883
#define MQTT_USER   "mqtt_user"         // leave "" if your broker needs no auth
#define MQTT_PASS   "mqtt_password"

// MQTT client id + OTA hostname + Home Assistant device identifier.
// Must be unique on your MQTT broker.
#define MQTT_CLIENT_ID "PoolPumpRS485"
